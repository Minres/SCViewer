sdk_root="${SDKMAN_DIR:-$HOME/.sdkman}"
source "$sdk_root/bin/sdkman-init.sh"

java_major=25
java_vendor=tem
maven_version=3.10.1

java_version=$(
    sdk list java |
        awk '{print $NF}' |
        grep -E "^${java_major}\.[0-9]+(\.[0-9]+)*(\+[0-9]+(\.[0-9]+)*)?-${java_vendor}$" |
        sort -V |
        tail -n 1
)

if [[ -z "$java_version" ]]; then
    log_error "No stable Java $java_major ($java_vendor) release found"
    return 1
fi

if [[ ! -x "$sdk_root/candidates/java/$java_version/bin/java" ]]; then
    # Answer “no” to changing SDKMAN's global default.
    sdk install java "$java_version" <<< "n" || return 1
fi

export JAVA_HOME="$sdk_root/candidates/java/$java_version"
PATH_add "$JAVA_HOME/bin"

if [[ ! -x "$sdk_root/candidates/maven/$maven_version/bin/mvn" ]]; then
    sdk install maven "$maven_version" <<< "n" || return 1
fi

export MAVEN_HOME="$sdk_root/candidates/maven/$maven_version"
PATH_add "$MAVEN_HOME/bin"
